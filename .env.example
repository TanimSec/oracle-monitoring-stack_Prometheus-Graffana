# ==============================================================================
# Oracle Cloud Monitoring Stack - Environment Configuration
# ==============================================================================

# Grafana Admin Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeThisToAStrongPassword123!

# Exposed Web Ports (Grafana & Uptime Kuma)
GRAFANA_PORT=3000
UPTIME_KUMA_PORT=3001

# Data Retention Settings
PROMETHEUS_RETENTION_TIME=15d
LOKI_RETENTION_TIME=168h
